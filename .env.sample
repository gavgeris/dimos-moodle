# =============================================================================
# Moodle 5.1 — Environment Variables Sample
# Copy to .env and fill in your values before running docker compose up
# =============================================================================

# --- Domain ------------------------------------------------------------------
MOODLE_WWWROOT=https://yourdomain.com

# --- Database ----------------------------------------------------------------
# Password for the bn_moodle database user.
MARIADB_PASSWORD=change_me_strong_password

# MariaDB root password (used only for DB administration)
ROOT_PASSWORD=change_me_root_password
